{
  "name": "fireball-studios-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A standalone static Fireball Studios portfolio with local WebP scroll storytelling.",
  "scripts": {
    "generate": "node --env-file-if-exists=.env --import tsx scripts/generate-pages.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/generate-pages.ts --dev && vite --host 127.0.0.1 --port 5175 --strictPort",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run generate && npm run type-check && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check:pages": "node scripts/check-http.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "gsap": "3.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "linkedom": "^0.18.12",
    "parse5": "^8.0.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=24"
  }
}
