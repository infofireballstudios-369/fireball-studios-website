# Copy to .env.local. Never commit credentials.
# Verify the sender domain with Resend first; use a bare sender email address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional additional staging origin, including https://.
CONTACT_SITE_ORIGIN=

# Optional for non-Netlify hosting; Netlify uses its native function rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only for one persistent server; not for serverless or multiple instances.
CONTACT_ALLOW_MEMORY_RATE_LIMIT=false

# Enable only when your reverse proxy overwrites client IP headers.
# Vercel is recognised automatically; other requests share a conservative limit.
CONTACT_TRUST_PROXY=false

# Set true for a public staging deployment; leave false for the live domain.
# Netlify and Vercel preview environments are detected automatically.
SITE_NOINDEX=false

# Existing GA4 web stream. Public ID, not an API secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7RV5GM0GCF
# Enable only in production after Enhanced Measurement is switched OFF in GA4.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
