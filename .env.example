# Build-time public settings only. Never put an API key or password here.
# Use the final Pages URL, including the repository path where applicable.
SITE_URL=https://fireballstudios.co.uk/
# Keep this separate preview out of search until its publication is approved.
NOINDEX=true

# Default: FormSubmit, no account; activate the email notification once.
# Use email for draft-only mode, or formspree for the optional provider below.
FORM_PROVIDER=formsubmit

# Optional public Formspree form URL, after verifying info@fireballstudios.co.uk
# Set the same FORMSPREE_ENDPOINT repository variable for a Pages build.
# Used only with FORM_PROVIDER=formspree.
FORMSPREE_ENDPOINT=
